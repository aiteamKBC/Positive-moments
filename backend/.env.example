# ===========================================================================
# backend/.env - THE one runtime environment file for every backend process:
# Django / Operations, QA Core, the nightly scheduler, the background QA /
# backfill runner, the media runner and the Bunny publisher
# (app/config/environment.py). On the VPS every systemd unit has
# EnvironmentFile=/var/www/Positive-moments/backend/.env (root:www-data 0640).
#
# NAMES ONLY here: never commit real values. A value already set in the process
# environment always wins over this file. A commented `# NAME=` line is optional:
# leave it commented to keep the code default (for some names an EMPTY value is
# not the same as unset).
#
# The frontend is configured separately (frontend/.env, VITE_* only: those values
# are compiled into the browser bundle). The kbc-media-worker container keeps its
# own services/kbc-media-worker/.env.
# ===========================================================================

# QA / Operations database (Neon pooled endpoint).
DATABASE_URL=
APTEM_DATABASE_URL=
# Kent LMS (read-only): LMS occurrence matching and recording links.
LMS_DATABASE_URL=
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Sign in with Microsoft (same tenant as the Communication Centre). Empty
# MICROSOFT_SSO_REDIRECT_URI switches it off. Tenant/client/secret default to
# the MICROSOFT_GRAPH_* values below; set these only to use a separate app.
MICROSOFT_SSO_REDIRECT_URI=https://positive-moments.kentbusinesscollege.net/api/auth/sso/callback
MICROSOFT_SSO_TENANT_ID=
MICROSOFT_SSO_CLIENT_ID=
MICROSOFT_SSO_CLIENT_SECRET=
MICROSOFT_SSO_EMAIL_DOMAINS=kentbusinesscollege.com,kentbusinesscollege.org

# KBC Lecture Intelligence shadow discovery (app-only Graph; never use /me)
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_SCOPE=https://graph.microsoft.com/.default
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
KBC_LECTURE_CALENDAR_USER_UPN=

# --- KBC Lecture Intelligence scheduler (Phase 4B) --------------------------
# SCHEDULER_ENABLED=true removes the platform's refusal to run a cycle. It
# does NOT create a process: install automation/scheduler/install-windows-task.ps1
# or run automation/scheduler/docker-compose.yml to provide the timing.
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Africa/Cairo
SCHEDULER_CRON=0 21,23 * * *
SCHEDULER_LOOKBACK_DAYS=3
SCHEDULER_DISCOVER=true
SCHEDULER_ALLOW_GRAPH=true
SCHEDULER_ALLOW_PROVIDER=true
SCHEDULER_ALLOW_LEGACY_WRITES=true

# --- Positive Moments media platform -----------------------------------------
# The ONLY new secret. Backend-only: never VITE_*, never frontend/.env.
CREATOMATE_API_KEY=
# Optional (safe defaults shown).
MEDIA_RENDER_PROVIDER=creatomate
MEDIA_RENDER_MAX_WIDTH=1280
MEDIA_RENDER_MAX_HEIGHT=720
MEDIA_RENDER_FPS=25
POSITIVE_MOMENT_PADDING_BEFORE_SECONDS=60
POSITIVE_MOMENT_PADDING_AFTER_SECONDS=60
MEDIA_RUNNER_CONCURRENCY=1
# Empty = the existing Positive Clips folder in automation/positive_clips/destination.json.
MEDIA_SHAREPOINT_DRIVE_ID=
MEDIA_POSITIVE_MOMENTS_FOLDER_ITEM_ID=
# Public https base URL of this site, for the Creatomate webhook. Empty = the
# runner polls render status instead (works, just slower).
MEDIA_WEBHOOK_BASE_URL=
# HMAC key for webhook URLs. Empty = DJANGO_SECRET_KEY.
MEDIA_WEBHOOK_SECRET=
# Empty = QA_MODEL_NAME (reuses the existing QA_MODEL_API_KEY).
POSITIVE_MOMENTS_MODEL_NAME=

# --- QA model and legacy n8n precheck -------------------------------------------
QA_MODEL_API_KEY=
# QA_MODEL_NAME=
# QA_MODEL_BASE_URL=
N8N_BASE_URL=
N8N_API_KEY=
# SCHEDULER_MAX_PASSES=

# --- Recording links (optional) ---------------------------------------------------
# RECORDING_LINK_MODE=
# RECORDING_LINK_SEARCH_REGION=
# RECORDING_LINK_CREATE_ORG_LINKS=
# RECORDING_FULL_MIN_EXPECTED_DURATION_RATIO=
# RECORDING_SHORT_FRAGMENT_MAX_EXPECTED_RATIO=
# RECORDING_SIZE_DOMINANCE_RATIO=

# --- Django / Operations (optional) -----------------------------------------------
# DJANGO_CSRF_TRUSTED_ORIGINS=
# SESSION_COOKIE_SECURE=
# CLIP_ON_DEMAND_WEBHOOK_URL=
SOCIAL_MEDIA_SERVICE_TOKEN=
# SOCIAL_MEDIA_REANALYSIS_WEBHOOK_URL=
# SOCIAL_MEDIA_MODEL_PRICES=

# --- Publisher API served by Django (LMS playback, docs) ---------------------------
PUBLISHER_LMS_SERVICE_TOKENS=
PUBLISHER_LMS_LIBRARY_ID=
PUBLISHER_LMS_PLAYBACK_ENABLED=false
# PUBLISHER_LMS_RATE=
# PUBLISHER_LMS_CAPTION_LANGUAGE=
# PUBLISHER_API_DOCS_ENABLED=
# PUBLISHER_BACKFILL_MAX_DAYS=

# --- Bunny publisher (bunny-publisher.service) --------------------------------------
# Defaults and the meaning of every name: deploy/publisher.env.template.
# The publisher's OWN direct (non-pooled) Neon URL. Required: the publisher never
# falls back to DATABASE_URL.
PUBLISHER_DATABASE_URL=
PUBLISHER_MODE=SHADOW
PUBLISHER_PRODUCTION_WRITE_ENABLED=false
PUBLISHER_START_DATE=
PUBLISHER_END_DATE=
PUBLISHER_LMS_TEST_PROGRAMMES=
PUBLISHER_ALERT_DESTINATION=
PUBLISHER_ALERT_DELIVERY_ENABLED=false
BUNNY_STAGING_LIBRARY_ID=
BUNNY_STAGING_API_KEY=
BUNNY_STAGING_ACCOUNT_API_KEY=
BUNNY_STAGING_CDN_HOSTNAME=
BUNNY_PRODUCTION_LIBRARY_ID=
BUNNY_PRODUCTION_API_KEY=
BUNNY_PRODUCTION_ACCOUNT_API_KEY=
BUNNY_PRODUCTION_CDN_HOSTNAME=
BUNNY_CDN_TOKEN_KEY=
