DATABASE_URL=
APTEM_DATABASE_URL=
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# KBC Lecture Intelligence shadow discovery (app-only Graph; never use /me)
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_SCOPE=https://graph.microsoft.com/.default
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
KBC_LECTURE_CALENDAR_USER_UPN=

# --- KBC Lecture Intelligence scheduler (Phase 4B) --------------------------
# SCHEDULER_ENABLED=true removes the platform's refusal to run a cycle. It
# does NOT create a process: install automation/scheduler/install-windows-task.ps1
# or run automation/scheduler/docker-compose.yml to provide the timing.
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Africa/Cairo
SCHEDULER_CRON=0 21,23 * * *
SCHEDULER_LOOKBACK_DAYS=3
SCHEDULER_DISCOVER=true
SCHEDULER_ALLOW_GRAPH=true
SCHEDULER_ALLOW_PROVIDER=true
SCHEDULER_ALLOW_LEGACY_WRITES=true

# --- Positive Moments media platform -----------------------------------------
# The ONLY new secret. Backend-only: never VITE_*, never frontend/.env.
CREATOMATE_API_KEY=
# Optional (safe defaults shown).
MEDIA_RENDER_PROVIDER=creatomate
MEDIA_RENDER_MAX_WIDTH=1280
MEDIA_RENDER_MAX_HEIGHT=720
MEDIA_RENDER_FPS=25
POSITIVE_MOMENT_PADDING_BEFORE_SECONDS=60
POSITIVE_MOMENT_PADDING_AFTER_SECONDS=60
MEDIA_RUNNER_CONCURRENCY=1
# Empty = the existing Positive Clips folder in automation/positive_clips/destination.json.
MEDIA_SHAREPOINT_DRIVE_ID=
MEDIA_POSITIVE_MOMENTS_FOLDER_ITEM_ID=
# Public https base URL of this site, for the Creatomate webhook. Empty = the
# runner polls render status instead (works, just slower).
MEDIA_WEBHOOK_BASE_URL=
# HMAC key for webhook URLs. Empty = DJANGO_SECRET_KEY.
MEDIA_WEBHOOK_SECRET=
# Empty = QA_MODEL_NAME (reuses the existing QA_MODEL_API_KEY).
POSITIVE_MOMENTS_MODEL_NAME=
