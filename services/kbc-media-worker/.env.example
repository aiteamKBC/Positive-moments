# ---------------------------------------------------------------------------
# KBC Media Worker configuration template.
# Copy to .env and fill in KBC_WORKER_SECRET. Never commit the real .env.
# This worker holds NO Microsoft credentials and NO database credentials.
# ---------------------------------------------------------------------------

# n8n production webhook endpoints (n8n is the only thing this worker talks to).
N8N_CLAIM_URL=https://n8n.srv943390.hstgr.cloud/webhook/kbc-media-jobs-claim
N8N_UPLOAD_SESSION_URL=https://n8n.srv943390.hstgr.cloud/webhook/kbc-media-jobs-upload-session
N8N_COMPLETE_URL=https://n8n.srv943390.hstgr.cloud/webhook/kbc-media-jobs-complete
N8N_FAIL_URL=https://n8n.srv943390.hstgr.cloud/webhook/kbc-media-jobs-fail

# Shared secret sent as the X-KBC-Worker-Secret header. Must match n8n.
KBC_WORKER_SECRET=

WORKER_ID=kbc-media-worker-local-01

# Worker behaviour
POLL_INTERVAL_SECONDS=60
IDLE_BACKOFF_SECONDS=60
REQUEST_TIMEOUT_SECONDS=120
FFMPEG_TIMEOUT_MINUTES=180
HEARTBEAT_INTERVAL_SECONDS=30

# Microsoft Graph resumable upload. Chunk size must be a multiple of 320 KiB.
UPLOAD_CHUNK_BYTES=10485760
UPLOAD_MAX_RETRIES=6

# positive_clip / cut_mode=precise encoding profile
PRECISE_VIDEO_CODEC=libx264
PRECISE_PRESET=veryfast
PRECISE_CRF=20
PRECISE_AUDIO_CODEC=aac
PRECISE_AUDIO_BITRATE=160k

# Optional overrides. Inside Docker these are set by docker-compose.yml.
# DATA_DIR=
# TMP_DIR=
