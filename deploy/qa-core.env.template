# ===========================================================================
# KBC QA CORE - production environment template
#
# NAMES ONLY. Every value is deliberately blank. Fill these in on the host,
# never in the repository, and never in this file.
#
# Deployed as `backend/.env`; the scheduler and the API both read it, which is
# what stops the two from disagreeing about the schedule or the database.
# ===========================================================================

# -- PostgreSQL --------------------------------------------------------------
# The managed Neon instance. One URL for the whole platform; the API opens
# read-only transactions for reads and only the scheduler writes.
DATABASE_URL=
# Read-only Aptem mirror used by roster reconciliation. Optional: absent means
# the Aptem comparison is skipped, not that QA fails.
APTEM_DATABASE_URL=

# -- Microsoft Graph (application permissions) --------------------------------
# Calendar discovery, meeting resolution and transcript acquisition.
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_BASE_URL=
MICROSOFT_GRAPH_SCOPE=
# The mailbox whose calendar defines the teaching timetable.
KBC_LECTURE_CALENDAR_USER_UPN=

# -- n8n read-only safety preflight -------------------------------------------
# GET only. Used to prove the legacy QA execution path is disabled before the
# coded pipeline is permitted to write. The key needs read scope and nothing
# more; this platform never POSTs, PATCHes or activates anything in n8n.
N8N_BASE_URL=
N8N_API_KEY=

# -- QA evaluation model -------------------------------------------------------
QA_MODEL_NAME=
QA_MODEL_API_KEY=

# -- Django / API --------------------------------------------------------------
DJANGO_SECRET_KEY=
# MUST be false in production.
DJANGO_DEBUG=false
# Comma-separated hostnames the API will answer for.
DJANGO_ALLOWED_HOSTS=
# Comma-separated origins the console is served from. Empty blocks the browser.
CORS_ALLOWED_ORIGINS=
# The shared operations console login.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# -- Scheduler -----------------------------------------------------------------
# SCHEDULER_ENABLED=false is the platform's refusal to write. It must be set
# to true for the nightly cycle to do anything, and that is the single switch
# the infrastructure team flips to go live.
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Africa/Cairo
SCHEDULER_CRON=0 21,23 * * *
SCHEDULER_LOOKBACK_DAYS=3
SCHEDULER_DISCOVER=
SCHEDULER_ALLOW_GRAPH=
SCHEDULER_ALLOW_PROVIDER=
# Legacy QA/Perfect writes. Gated additionally by the n8n preflight at runtime.
SCHEDULER_ALLOW_LEGACY_WRITES=

# ===========================================================================
# NOT part of QA Core. Do not set these for this release; the media worker is
# a separate stack that is still under development:
#   KBC_WORKER_SECRET, N8N_CLAIM_URL, N8N_UPLOAD_SESSION_URL,
#   N8N_COMPLETE_URL, N8N_FAIL_URL, WORKER_ID
# ===========================================================================
