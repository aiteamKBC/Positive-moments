# KBC Continuous Bunny Publisher - EnvironmentFile template (bunny-publisher.service).
# Install as /var/www/Positive-moments/backend/config/publisher.env with
#   sudo install -m 640 -o root -g www-data deploy/publisher.env.template backend/config/publisher.env
# then fill it with sudoedit. Values are secrets: never commit, paste or log the filled copy.
#
# Continuous production (P1): PUBLISHER_MODE=STAGING_WRITE with the verified staging library
# (videos stay HIDDEN), PUBLISHER_START_DATE = the go-live day (2026-10-23), PUBLISHER_END_DATE
# EMPTY so the window rolls with the Africa/Cairo day.

# --- mode -----------------------------------------------------------------------
# SHADOW (default): discovery, matching, transcript + recording acquisition and
# import PLANNING only - no Bunny writes. STAGING_WRITE: the staging library only.
# PRODUCTION_WRITE: refused unless PUBLISHER_PRODUCTION_WRITE_ENABLED=true.
PUBLISHER_MODE=SHADOW
# Lectures before this date are historical-backfill scope (never planned).
# YYYY-MM-DD, an Africa/Cairo calendar date (lecture_sessions.session_date).
PUBLISHER_START_DATE=
# Optional inclusive upper bound, for a scoped replay only (START = END = that day).
# Leave EMPTY in continuous production.
PUBLISHER_END_DATE=
# Days re-planned behind today (Cairo) for late Teams recordings/transcripts and catch-up after
# downtime; queued jobs from older days keep running to a terminal state regardless.
PUBLISHER_LOOKBACK_DAYS=3
PUBLISHER_LMS_TEST_PROGRAMMES=
PUBLISHER_DISCOVER_CALENDAR=true

# --- Lecture Intelligence database: the publisher's OWN connection ------------------
# Neon DIRECT endpoint only (host WITHOUT "-pooler"): the publisher holds session
# advisory locks. A pooled host is refused at startup. QA, Django and the media
# runner keep their pooled DATABASE_URL in their own env files; do not add
# DATABASE_URL here.
PUBLISHER_DATABASE_URL=

# --- other sources / Graph (same names the platform already uses) -------------------
APTEM_DATABASE_URL=
LMS_DATABASE_URL=
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_SCOPE=https://graph.microsoft.com/.default
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
KBC_LECTURE_CALENDAR_USER_UPN=
RECORDING_LINK_SEARCH_REGION=

# --- Bunny staging (STAGING_WRITE) ---------------------------------------------------
BUNNY_STAGING_LIBRARY_ID=
BUNNY_STAGING_API_KEY=
# Account / subuser key: read-only check of Free encoding + disabled AI transcribing.
BUNNY_STAGING_ACCOUNT_API_KEY=
BUNNY_STAGING_CDN_HOSTNAME=

# --- Bunny production (PRODUCTION_WRITE; disabled by default) -------------------------
PUBLISHER_PRODUCTION_WRITE_ENABLED=false
BUNNY_PRODUCTION_LIBRARY_ID=
BUNNY_PRODUCTION_API_KEY=
BUNNY_PRODUCTION_ACCOUNT_API_KEY=
# Library 786045 is adopted as the production library: BUNNY_PRODUCTION_LIBRARY_ID may equal the staging
# library (see deploy/DELIVERY_ROLLOUT.md, phase C). The caption read-back host:
BUNNY_PRODUCTION_CDN_HOSTNAME=
# --- learner-delivery security policy (security-check / release) ----------------------
# CDN token authentication: DEFERRED for the current rollout (not a release blocker; caption read-back
# unsigned; no key needed). REQUIRED later = a release blocker, and BUNNY_CDN_TOKEN_KEY signs the read-back.
PUBLISHER_CDN_TOKEN_AUTH=DEFERRED
BUNNY_CDN_TOKEN_KEY=
PUBLISHER_APPROVED_REFERRERS=lms.kentbusinesscollege.org
PUBLISHER_REQUIRE_BLOCK_NONE_REFERRER=true
# --- automatic release (OFF by default; deploy/DELIVERY_ROLLOUT.md, "Automatic release") ---------------
# true: the scheduler's AUTO_RELEASE task (every discovery interval) releases ANY lecture - live or
# historical backfill, no date restriction - that is READY (verified video; captions optional), LMS-match
# VERIFIED, every part still HIDDEN and never released/withdrawn, after a live library security check -
# through the audited `release` workflow. Needs PRODUCTION_WRITE. Withdrawn, duplicate, unmatched,
# cancelled or unverified lectures and new parts of released lectures never qualify.
PUBLISHER_AUTO_RELEASE=false

# --- runtime ---------------------------------------------------------------------------
PUBLISHER_WORKERS=2
PUBLISHER_MAX_IMPORTS_IN_FLIGHT=2
PUBLISHER_POLL_SECONDS=5
PUBLISHER_DISCOVERY_INTERVAL_SECONDS=300
PUBLISHER_LIGHT_RECONCILE_HOURS=6
PUBLISHER_FULL_RECONCILE_AT=05:00
PUBLISHER_JOB_LEASE_SECONDS=900
PUBLISHER_ENCODING_STALL_HOURS=6
PUBLISHER_MAX_IMPORT_GENERATIONS=3

# --- alerts (prepared; delivery is NOT enabled in this phase) ---------------------------
PUBLISHER_ALERT_DESTINATION=
PUBLISHER_ALERT_DELIVERY_ENABLED=false
