        "jsCode": "// Day window for Africa/Cairo with correct offset in the output.\n// Same shape as Create Date Range2 in the per-lecture workflows.\nconst TZ = 'Africa/Cairo';\n\nfunction partsInTz(d, tz=TZ){\n  const fmt = new Intl.DateTimeFormat('en-GB',{\n    timeZone: tz, year:'numeric', month:'2-digit', day:'2-digit',\n    hour:'2-digit', minute:'2-digit', second:'2-digit', hour12:false\n  });\n  const obj = Object.fromEntries(fmt.formatToParts(d).map(p=>[p.type,p.value]));\n  return { yyyy: obj.year, mm: obj.month, dd: obj.day };\n}\n\nfunction tzOffsetHHMM(date, tz=TZ){\n  const utc = new Date(Date.UTC(\n    date.getFullYear(), date.getMonth(), date.getDate(),\n    date.getHours(), date.getMinutes(), date.getSeconds(), date.getMilliseconds()\n  ));\n  const inTz = new Date(utc.toLocaleString('en-US',{ timeZone: tz }));\n  const offMin = Math.round((inTz - utc)/60000);\n  const sign = offMin >= 0 ? '+' : '-';\n  const a = Math.abs(offMin);\n  const H = String(Math.floor(a/60)).padStart(2,'0');\n  const M = String(a%60).padStart(2,'0');\n  return `${sign}${H}:${M}`;\n}\n\nconst now = new Date();\nconst { yyyy, mm, dd } = partsInTz(now, TZ);\n\n\nconst startLocal = new Date(`${yyyy}-${mm}-${dd}T00:00:00`);\nconst off = tzOffsetHHMM(startLocal, TZ);\n\nreturn [{\n  json: {\n    targetDate:   `${yyyy}-${mm}-${dd}`,\n    today:        `${yyyy}-${mm}-${dd}T00:00:00${off}`,\n    todayPlusOne: `${yyyy}-${mm}-${dd}T23:59:59${off}`\n  }\n}];"
