    {
      "parameters": {
        "jsCode": "const lectures =\n  $items('Collect Lectures and Exact Graph Times')[0]?.json?.lectures || [];\nconst tenantFiles =\n  $items('Collect Tenant Search Candidates')[0]?.json?.tenant_search_files || [];\nconst channelFiles =\n  $items('Collect All Channel Recording Files')[0]?.json?.channel_recording_files || [];\nconst oneDriveResponse = items[0]?.json || {};\nconst oneDriveFiles = (Array.isArray(oneDriveResponse.value) ? oneDriveResponse.value : [])\n  .filter(file => file?.id && file?.file && /\\.mp4$/i.test(String(file.name || '')))\n  .map(file => ({\n    id: file.id,\n    driveId: file?.parentReference?.driveId || null,\n    name: file.name,\n    webUrl: file.webUrl || null,\n    createdDateTime: file.createdDateTime || null,\n    lastModifiedDateTime: file.lastModifiedDateTime || null,\n    source: 'current_user_onedrive_recordings'\n  }));\n\nconst deduped = new Map();\nfor (const file of [...tenantFiles, ...channelFiles, ...oneDriveFiles]) {\n  if (!file?.id || !file?.driveId) continue;\n  const key = String(file.driveId) + ':' + String(file.id);\n  const previous = deduped.get(key) || {};\n  deduped.set(key, { ...previous, ...file });\n}\nconst files = [...deduped.values()];\n\n// This is the same subject normalization used by QA One Lecture v8.\n// It intentionally treats \"Dr.Femi ...\" and \"Femi ...\" as the same subject.\nconst normalizeSubject = value => String(value || '')\n  .toLowerCase()\n  .replace(/&amp;/g, '&')\n  .replace(/[^a-z0-9]+/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .replace(/^(dr|doctor|prof|professor|mr|mrs|ms)\\s+/, '')\n  .replace(/[^a-z0-9]+/g, '');\n\nfunction parseTeamsFilename(name) {\n  const match = String(name || '').match(\n    /^(.*)-(\\d{8})_(\\d{6})(?:UTC)?-Meeting Recording\\.mp4$/i\n  );\n  if (!match) return null;\n  const date = match[2];\n  const time = match[3];\n  const iso = date.slice(0, 4) + '-' + date.slice(4, 6) + '-' + date.slice(6, 8) +\n    'T' + time.slice(0, 2) + ':' + time.slice(2, 4) + ':' + time.slice(4, 6) + 'Z';\n  const timestamp = Date.parse(iso);\n  if (!Number.isFinite(timestamp)) return null;\n  return { subject: match[1], timestamp, iso };\n}\n\nreturn lectures.map((lecture, index) => {\n  const graphTimestamp = Date.parse(lecture.graph_created_at || '');\n  const normalizedSubject = normalizeSubject(lecture.subject);\n  const maxDiff = Number(lecture.max_timestamp_difference_seconds || 15);\n\n  const exactCandidates = files\n    .map(file => ({ file, parsed: parseTeamsFilename(file.name) }))\n    .filter(candidate => candidate.parsed)\n    .map(candidate => ({\n      ...candidate,\n      subject_exact: normalizeSubject(candidate.parsed.subject) === normalizedSubject,\n      difference_seconds: Number.isFinite(graphTimestamp)\n        ? Math.abs(candidate.parsed.timestamp - graphTimestamp) / 1000\n        : null\n    }))\n    .filter(candidate => candidate.subject_exact &&\n      candidate.difference_seconds !== null && candidate.difference_seconds <= maxDiff)\n    .sort((a, b) => a.difference_seconds - b.difference_seconds);\n\n  let status = 'recording_file_not_found_in_accessible_locations';\n  if (lecture.graph_status !== 'exact_graph_recording_found') status = lecture.graph_status;\n  else if (exactCandidates.length > 1) status = 'ambiguous_exact_recording_files_no_update';\n  else if (exactCandidates.length === 1) status = 'exact_recording_file_matched';\n\n  const best = exactCandidates.length === 1 ? exactCandidates[0] : null;\n  const file = best?.file || null;\n  return {\n    json: {\n      ...lecture,\n      recording_item_id: file?.id || null,\n      recording_drive_id: file?.driveId || null,\n      recording_filename: file?.name || null,\n      recording_web_url: file?.webUrl || null,\n      recording_source: file?.source || null,\n      recording_team_name: file?.team_name || null,\n      recording_channel_name: file?.channel_name || null,\n      timestamp_difference_seconds: best?.difference_seconds ?? null,\n      exact_file_matches: exactCandidates.length,\n      candidate_files_seen: files.length,\n      recording_match_method: best ? 'exact_call_id_subject_and_timestamp_v8' : null,\n      ambiguous_candidate_filenames: exactCandidates.length > 1\n        ? exactCandidates.map(candidate => candidate.file?.name || null) : [],\n      recording_link_status: status\n    },\n    pairedItem: { item: index }\n  };\n});"
      },
