        "jsCode": "function decodeSessionId(value) {\n  const raw = String(value || '').trim();\n  const base64 = raw.replace(/-/g, '+').replace(/_/g, '/');\n  const padded = base64 + '='.repeat((4 - (base64.length % 4)) % 4);\n  try {\n    return Buffer.from(padded, 'base64').toString('utf8');\n  } catch {\n    return '';\n  }\n}\n\nconst guid = '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}';\nconst settings = $items('Run Settings - EDIT HERE')[0].json;\n\nreturn items.map((item, index) => {\n  const lecture = item.json || {};\n  const decoded = decodeSessionId(lecture.session_id);\n  const transcript = decoded.match(new RegExp('(' + guid + ')-\\\\d+-TranscriptV2', 'i'));\n  const allGuids = decoded.match(new RegExp(guid, 'ig')) || [];\n  const callId = String(transcript?.[1] || allGuids.at(-1) || '').toLowerCase();\n\n  return {\n    json: {\n      ...lecture,\n      expected_call_id: callId || null,\n      dry_run: Boolean(settings.dry_run),\n      allow_overwrite_existing: false,\n      max_timestamp_difference_seconds: Number(settings.max_timestamp_difference_seconds || 15)\n    },\n    pairedItem: { item: index }\n  };\n});"
