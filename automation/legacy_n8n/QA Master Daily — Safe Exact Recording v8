        "jsCode": "// Match each Teams calendar event to one active Aptem group.\nfunction normalizeGroup(value) {\n  return String(value || '')\n    .toLowerCase()\n    .replace(/&amp;/g, '&')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nconst groupItems = $items(\"Get Active Groups\") || [];\nconst groupLookup = new Map();\nfor (const item of groupItems) {\n  const original = item?.json?.group_name;\n  const normalized = normalizeGroup(original);\n  if (original && normalized) groupLookup.set(normalized, original);\n}\n\nconst evaluated = items.map(item => {\n  const event = item.json || {};\n  const normalizedSubject = normalizeGroup(event.subject);\n  const module = groupLookup.get(normalizedSubject) || null;\n  const matched = Boolean(module && event.meetingId);\n  return {\n    ...event,\n    matched,\n    module,\n    targetDate: String(event.meetingStart || '').slice(0, 10),\n    scheduledStart: event.meetingStart || '',\n    scheduledEnd: event.meetingEnd || '',\n    matchReason: matched\n      ? 'normalized subject equals active Aptem group'\n      : !event.meetingId ? 'missing meetingId' : 'no active group match'\n  };\n});\n\nconst matchedCount = evaluated.filter(row => row.matched).length;\nconst summary = {\n  total_calendar_events: evaluated.length,\n  total_active_groups: groupLookup.size,\n  matched_count: matchedCount,\n  unmatched_count: evaluated.length - matchedCount\n};\n\nreturn evaluated.map(row => ({ json: { ...row, _summary: summary } }));"
